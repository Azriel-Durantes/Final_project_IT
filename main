#include <iostream>
#include <string>
#include <vector>
#include <array>

using namespace std;

int main() {
    array<string, 7> programs = {
        "Information Technology",
        "Hospitality & Tourism Management",
        "Electrical and Electronic Engineering Technology",
        "Architecture",
        "Business Entrepreneurship",
        "Biology/Natural Resource Management",
        "Agriculture Business"
    };

    vector<string> names;
    vector<string> classes;
    vector<int> years;
    vector<int> tickets;
    vector<int> seats;
    array<bool, 20> chairs = {};
    int choice = 0;

    while (choice != 4) {
        cout << "\n--- School Event Registration ---" << endl;
        cout << "1. Register student" << endl;
        cout << "2. View registered students" << endl;
        cout << "3. View chairs" << endl;
        cout << "4. Exit" << endl;
        cout << "Enter choice: ";
        while (!(cin >> choice)) {
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "Enter a number: ";
        }
        cin.ignore(1000, '\n');

        if (choice == 1) {
            int taken = 0;
            for (int i = 0; i < chairs.size(); i++) {
                if (chairs[i]) {
                    taken++;
                }
            }
            if (taken == chairs.size()) {
                cout << "All chairs are taken." << endl;
                continue;
            }

            string name;
            int classChoice;
            int year;
            int ticket;
            int chair;

            cout << "Enter student name: ";
            getline(cin, name);
            while (name == "") {
bool validName = false;
while (!validName) {
    validName = true;
    if (name == "") {
        cout << "Name cannot be blank. Enter student name: ";
        getline(cin, name);
        validName = false;
    } else {
        for (int i = 0; i < names.size(); i++) {
            if (names[i] == name) {
                cout << "That name is already registered. Enter a different name: ";
                getline(cin, name);
                validName = false;
                break;
            }
        }
    }
}
            

            cout << "\nSelect student's class:" << endl;
            for (int i = 0; i < programs.size(); i++) {
                cout << i + 1 << ". " << programs[i] << endl;
            }
            cout << "Enter class number: ";
            while (!(cin >> classChoice) || classChoice < 1 || classChoice > 7) {
                cin.clear();
                cin.ignore(1000, '\n');
                cout << "Enter a number from 1 to 7: ";
            }
            cin.ignore(1000, '\n');

            cout << "Enter year (1 or 2): ";
            while (!(cin >> year) || year < 1 || year > 2) {
                cin.clear();
                cin.ignore(1000, '\n');
                cout << "Enter 1 or 2: ";
            }
            cin.ignore(1000, '\n');

            cout << "\nSelect ticket type:" << endl;
            cout << "1. Basic - Free (includes a drink)" << endl;
            cout << "2. Meal - $10 (includes a meal and a coke)" << endl;
            cout << "Enter ticket number: ";
            while (!(cin >> ticket) || ticket < 1 || ticket > 2) {
                cin.clear();
                cin.ignore(1000, '\n');
                cout << "Enter 1 or 2: ";
            }
            cin.ignore(1000, '\n');

            cout << "\nSelect your chair:" << endl;
            for (int i = 0; i < chairs.size(); i++) {
                if (chairs[i]) {
                    cout << "[XX] ";
                } else if (i + 1 < 10) {
                    cout << "[ " << i + 1 << "] ";
                } else {
                    cout << "[" << i + 1 << "] ";
                }
                if ((i + 1) % 5 == 0) {
                    cout << endl;
                }
            }
            cout << "Enter chair number: ";
            while (!(cin >> chair) || chair < 1 || chair > 20 || chairs[chair - 1]) {
                cin.clear();
                cin.ignore(1000, '\n');
                cout << "Invalid or taken. Enter a free chair number: ";
            }
            cin.ignore(1000, '\n');
            chairs[chair - 1] = true;

            names.push_back(name);
            classes.push_back(programs[classChoice - 1]);
            years.push_back(year);
            tickets.push_back(ticket);
            seats.push_back(chair);
            cout << "Student registered." << endl;
        } else if (choice == 2) {
            if (names.size() == 0) {
                cout << "No students registered yet." << endl;
            } else {
                for (int i = 0; i < names.size(); i++) {
                    string ticketName = "Basic (free)";
                    if (tickets[i] == 2) {
                        ticketName = "Meal ($10)";
                    }
                    cout << i + 1 << ". " << names[i] << " - " << classes[i] << ", Year " << years[i] << " - " << ticketName << ", Chair " << seats[i] << endl;
                }
            }
        } else if (choice == 3) {
            cout << "\n--- Chairs ---" << endl;
            for (int i = 0; i < chairs.size(); i++) {
                if (chairs[i]) {
                    cout << "[XX] ";
                } else if (i + 1 < 10) {
                    cout << "[ " << i + 1 << "] ";
                } else {
                    cout << "[" << i + 1 << "] ";
                }
                if ((i + 1) % 5 == 0) {
                    cout << endl;
                }
            }
        } else if (choice == 4) {
            cout << "Goodbye." << endl;
        } else {
            cout << "Invalid choice." << endl;
        }
    }

    return 0;
}
