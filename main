#include <iostream>
#include <string>
#include <vector>
#include <array>

using namespace std;

int main() {
    array<string, 7> programs = {
        "Information Technology",
        "Hospitality & Tourism Management",
        "Electrical and Electronic Engineering Technology",
        "Architecture",
        "Business Entrepreneurship",
        "Biology/Natural Resource Management",
        "Agriculture Business"
    };

    vector<string> names;
    vector<string> classes;
    vector<int> years;
    int choice = 0;

    while (choice != 3) {
        cout << "\n--- School Event Registration ---" << endl;
        cout << "1. Register student" << endl;
        cout << "2. View registered students" << endl;
        cout << "3. Exit" << endl;
        cout << "Enter choice: ";
        while (!(cin >> choice)) {
            cin.clear();
            cin.ignore(1000, '\n');
            cout << "Enter a number: ";
        }
        cin.ignore(1000, '\n');

        if (choice == 1) {
            string name;
            int classChoice;
            int year;

            cout << "Enter student name: ";
            getline(cin, name);
            while (name == "") {
                cout << "Name cannot be blank. Enter student name: ";
                getline(cin, name);
            }

            cout << "\nSelect student's class:" << endl;
            for (int i = 0; i < programs.size(); i++) {
                cout << i + 1 << ". " << programs[i] << endl;
            }
            cout << "Enter class number: ";
            while (!(cin >> classChoice) || classChoice < 1 || classChoice > 7) {
                cin.clear();
                cin.ignore(1000, '\n');
                cout << "Enter a number from 1 to 7: ";
            }
            cin.ignore(1000, '\n');

            cout << "Enter year (1 or 2): ";
            while (!(cin >> year) || year < 1 || year > 2) {
                cin.clear();
                cin.ignore(1000, '\n');
                cout << "Enter 1 or 2: ";
            }
            cin.ignore(1000, '\n');

            names.push_back(name);
            classes.push_back(programs[classChoice - 1]);
            years.push_back(year);
            cout << "Student registered." << endl;
        } else if (choice == 2) {
            if (names.size() == 0) {
                cout << "No students registered yet." << endl;
            } else {
                for (int i = 0; i < names.size(); i++) {
                    cout << i + 1 << ". " << names[i] << " - " << classes[i] << ", Year " << years[i] << endl;
                }
            }
        } else if (choice == 3) {
            cout << "Goodbye." << endl;
        } else {
            cout << "Invalid choice." << endl;
        }
    }

    return 0;
}
