#include <iostream>
#include <string>
#include <vector>

using namespace std;

int main() {
    vector<string> names;
    vector<string> grades;
    int choice = 0;

    while (choice != 3) {
        cout << "\n--- School Event Registration ---" << endl;
        cout << "1. Register student" << endl;
        cout << "2. View registered students" << endl;
        cout << "3. Exit" << endl;
        cout << "Enter choice: ";
        cin >> choice;
        cin.ignore();

        if (choice == 1) {
            string name;
            string grade;
            cout << "Enter student name: ";
            while (name == "") {
    cout << "Name cannot be blank. Enter student name: ";
    getline(cin, name);
}
            cout << "Enter grade/form: ";
            getline(cin, grade);
            names.push_back(name);
            grades.push_back(grade);
            cout << "Student registered." << endl;
        } else if (choice == 2) {
            if (names.size() == 0) {
                cout << "No students registered yet." << endl;
            } else {
                for (int i = 0; i < names.size(); i++) {
                    cout << i + 1 << ". " << names[i] << " - " << grades[i] << endl;
                }
            }
        } else if (choice == 3) {
            cout << "Goodbye." << endl;
        } else {
            cout << "Invalid choice." << endl;
        }
    }

    return 0;
}