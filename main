
#include <iostream>
#include <string>
#include <vector>
#include <array>
#include <cctype>
#include "Student.h"

using namespace std;

const int TOTAL_CHAIRS = 20;
const int TOTAL_PROGRAMS = 7;

int readNumber(string prompt, int low, int high) {
    int number;
    cout << prompt;
    while (!(cin >> number) || number < low || number > high) {
        cin.clear();
        cin.ignore(1000, '\n');
        cout << "Enter a number from " << low << " to " << high << ": ";
    }
    cin.ignore(1000, '\n');
    return number;
}

string readText(string prompt, string label) {
    string text;
    cout << prompt;
    getline(cin, text);
    while (text == "") {
        cout << label << " cannot be blank. " << prompt;
        getline(cin, text);
    }
    return text;
}

string toLower(string text) {
    for (int i = 0; i < text.size(); i++) {
        text[i] = tolower(text[i]);
    }
    return text;
}

int findStudent(const vector<Student>& students, string name) {
    for (int i = 0; i < students.size(); i++) {
        if (toLower(students[i].getName()) == toLower(name)) {
            return i;
        }
    }
    return -1;
}

void showChairs(const array<bool, TOTAL_CHAIRS>& chairs) {
    for (int i = 0; i < chairs.size(); i++) {
        if (chairs[i]) {
            cout << "[XX] ";
        } else if (i + 1 < 10) {
            cout << "[ " << i + 1 << "] ";
        } else {
            cout << "[" << i + 1 << "] ";
        }
        if ((i + 1) % 5 == 0) {
            cout << endl;
        }
    }
}

void registerStudent(vector<Student>& students, array<bool, TOTAL_CHAIRS>& chairs, const array<string, TOTAL_PROGRAMS>& programs) {
    if (students.size() >= chairs.size()) {
        cout << "All chairs are taken. Registration is full." << endl;
        return;
    }

    string name = readText("Enter student name: ", "Name");
    while (findStudent(students, name) != -1) {
        cout << "That name is already registered." << endl;
        name = readText("Enter a different name: ", "Name");
    }

    string password = readText("Create a password: ", "Password");

    cout << "\nSelect student's class:" << endl;
    for (int i = 0; i < programs.size(); i++) {
        cout << i + 1 << ". " << programs[i] << endl;
    }

    int classChoice = readNumber("Enter class number: ", 1, TOTAL_PROGRAMS);
    int year = readNumber("Enter year (1 or 2): ", 1, 2);

    cout << "\nSelect ticket type:" << endl;
    cout << "1. Basic - Free (includes a drink)" << endl;
    cout << "2. Meal - $10 (includes a meal and a coke)" << endl;

    int ticket = readNumber("Enter ticket number: ", 1, 2);

    cout << "\nSelect your chair:" << endl;
    showChairs(chairs);

    int chair = readNumber("Enter chair number: ", 1, TOTAL_CHAIRS);
    while (chairs[chair - 1]) {
        cout << "That chair is taken." << endl;
        chair = readNumber("Enter a free chair number: ", 1, TOTAL_CHAIRS);
    }

    chairs[chair - 1] = true;

    Student s(name, password, programs[classChoice - 1], year, ticket, chair);
    students.push_back(s);

    cout << "Student registered. Your chair is number " << chair << "." << endl;
}

void loginStudent(const vector<Student>& students) {
    if (students.size() == 0) {
        cout << "No students registered yet." << endl;
        return;
    }

    string name = readText("Enter student name: ", "Name");
    string password = readText("Enter password: ", "Password");

    int index = findStudent(students, name);

    if (index == -1 || !students[index].checkPassword(password)) {
        cout << "Invalid name or password." << endl;
        return;
    }

    cout << "\nWelcome, " << students[index].getName() << "!" << endl;
    cout << "Class: " << students[index].getProgramName() << ", Year " << students[index].getYear() << endl;
    cout << "Ticket: " << students[index].getTicketName() << endl;

    if (students[index].getTicket() == 2) {
        cout << "Meal: Yes - $" << students[index].getPrice() << " meal and coke" << endl;
    } else {
        cout << "Meal: No" << endl;
    }

    cout << "Your chair: " << students[index].getChair() << endl;
}

void showStudents(const vector<Student>& students) {
    if (students.size() == 0) {
        cout << "No students registered yet." << endl;
        return;
    }

    for (int i = 0; i < students.size(); i++) {
        cout << i + 1 << ". " << students[i].getName() << " - " << students[i].getProgramName()
             << ", Year " << students[i].getYear() << " - " << students[i].getTicketName()
             << ", Chair " << students[i].getChair() << endl;
    }
}

void showSummary(const vector<Student>& students, int totalChairs) {
    int meals = 0;
    int money = 0;

    for (int i = 0; i < students.size(); i++) {
        if (students[i].getTicket() == 2) {
            meals++;
        }
        money = money + students[i].getPrice();
    }

    int total = students.size();

    cout << "\n--- Event Summary ---" << endl;
    cout << "Students registered: " << total << endl;
    cout << "Basic tickets: " << total - meals << endl;
    cout << "Meal tickets: " << meals << endl;
    cout << "Money collected: $" << money << endl;
    cout << "Chairs left: " << totalChairs - total << " of " << totalChairs << endl;
}

int main() {
    array<string, TOTAL_PROGRAMS> programs = {
        "Information Technology",
        "Hospitality & Tourism Management",
        "Electrical and Electronic Engineering Technology",
        "Architecture",
        "Business Entrepreneurship",
        "Biology/Natural Resource Management",
        "Agriculture Business"
    };

    vector<Student> students;
    array<bool, TOTAL_CHAIRS> chairs = {};
    int choice = 0;

    while (choice != 6) {
        cout << "\n--- School Event Registration ---" << endl;
        cout << "1. Register student" << endl;
        cout << "2. Student login" << endl;
        cout << "3. View chairs" << endl;
        cout << "4. View registered students" << endl;
        cout << "5. Event summary" << endl;
        cout << "6. Exit" << endl;

        choice = readNumber("Enter choice: ", 1, 6);

        if (choice == 1) {
            registerStudent(students, chairs, programs);
        } else if (choice == 2) {
            loginStudent(students);
        } else if (choice == 3) {
            cout << "\n--- Chairs ---" << endl;
            showChairs(chairs);
        } else if (choice == 4) {
            showStudents(students);
        } else if (choice == 5) {
            showSummary(students, chairs.size());
        } else {
            cout << "Goodbye." << endl;
        }
    }

    return 0;
}
